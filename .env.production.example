# Production variables for docker-compose.yaml. Fill them in Coolify's
# environment page, or use this file as is for a local run:
#
#   docker compose --env-file .env.production.example \
#     -f docker-compose.yaml -f docker-compose.local.yaml up --build
#
# manif has no database and no accounts, so there are no secrets.

# --- Client build arg (public: it ends up in the browser bundle) -------------
# Where the browser finds the game server. A path means "this same origin":
# the client's Caddy proxies it to the server container. Leave as is.
VITE_SERVER_URL=/colyseus

# --- Local only ----------------------------------------------------------------
# Port docker-compose.local.yaml publishes the client on (default 8080).
# CLIENT_PORT=8080
