{
  "name": "@manif/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/app/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "test": "bun test src"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.39",
    "@colyseus/ws-transport": "0.18.4",
    "@manif/shared": "workspace:*",
    "@sentry/node": "11.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
