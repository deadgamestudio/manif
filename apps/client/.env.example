# Colyseus server endpoint. Defaults to ws://<page host>:2567 when unset.
# A path such as /colyseus means "this same origin" (https gives wss): the
# production image's Caddy proxies it to the game server.
VITE_SERVER_URL=ws://localhost:2567

# Rustrak DSN for error tracking (a public ingest key). Optional in dev:
# unset turns reporting off.
VITE_SENTRY_DSN=https://d0c9bddd10f34714ac2833a55eaf7678@rustrack.bazlab.si/5
