# Plain HTTP on :80. In production Coolify's proxy (Traefik) terminates TLS in
# front of this container, so Caddy must not try to get certificates itself.
{
	auto_https off
	admin off
}

:80 {
	# The game server: HTTP matchmaking and the room WebSockets. handle_path
	# strips the /colyseus prefix; reverse_proxy passes WebSocket upgrades
	# through on its own.
	handle_path /colyseus/* {
		reverse_proxy server:2567 {
			# Colyseus answers matchmaking errors with their error code as the
			# HTTP status: 522 "room not found", 524 "room locked/full", etc.
			# Cloudflare treats 520-527 as its own origin errors and replaces
			# the body with "error code: 522", so the client loses the reason.
			# Re-send them as 409 with the body untouched.
			@colyseus_err status 520 521 522 523 524 525 526 527
			handle_response @colyseus_err {
				copy_response 409
			}
		}
	}

	# Vite's hashed bundles never change under the same name. A missing one is
	# a real 404, not the page.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else revalidates. There is one page: any other path falls
	# back to index.html (SPA). The invite link is /?lobby=<code>, read by
	# the client, so it needs no rewrite.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
