# Plain HTTP on :80. In production Coolify's proxy (Traefik) terminates TLS in
# front of this container, so Caddy must not try to get certificates itself.
{
	auto_https off
	admin off
	# Only Coolify's Traefik (on the private Docker network) reaches Caddy, so
	# trust it: the X-Forwarded-For it sends is passed on with its address
	# appended, instead of being replaced by it. The game server reads the
	# visitor's address from the right end of that header to limit how many
	# lobbies one visitor creates (apps/server/src/features/lobby/visitor.ts).
	servers {
		trusted_proxies static private_ranges
	}
}

# Security headers, on every response (imported below, errors included).
# CSP, what the page really loads:
# - scripts: only our own Vite bundles (no inline script; the JSON-LD
#   block is data, not run);
# - styles: our CSS, Google Fonts' stylesheet, and inline styles (React
#   and the HUD set style attributes);
# - fonts: Google Fonts' files;
# - images and sounds: our own files, plus data:/blob: (three.js textures);
# - connections: this origin (matchmaking, sounds), the room WebSocket on
#   this same host, and the Rustrak error ingest (VITE_SENTRY_DSN's host:
#   change it here if the DSN moves).
# Nothing may frame the page. Referrers leave as the origin only, so an
# invite link's code never reaches another site.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ws://{hostport} wss://{hostport} https://rustrack.bazlab.si; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

:80 {
	import security_headers
	# Error responses (a missing asset) start from scratch: same headers.
	handle_errors {
		import security_headers
	}

	# The game server's root page only names the framework and its version:
	# nobody needs it, so it is a plain 404 here.
	handle /colyseus/ {
		respond 404
	}

	# The game server: HTTP matchmaking and the room WebSockets. handle_path
	# strips the /colyseus prefix; reverse_proxy passes WebSocket upgrades
	# through on its own.
	handle_path /colyseus/* {
		reverse_proxy server:2567 {
			# Colyseus answers matchmaking errors with their error code as the
			# HTTP status: 522 "room not found", 524 "room locked/full", etc.
			# Cloudflare treats 520-527 as its own origin errors and replaces
			# the body with "error code: 522", so the client loses the reason.
			# Re-send them as 409 with the body untouched.
			@colyseus_err status 520 521 522 523 524 525 526 527
			handle_response @colyseus_err {
				copy_response 409
			}
		}
	}

	# Vite's hashed bundles never change under the same name. A missing one is
	# a real 404, not the page.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The link preview images: not hashed, so not forever, but a day is fine.
	handle /og/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=86400"
		file_server
	}

	# Everything else (the pages, robots.txt, sitemap.xml, the icons)
	# revalidates. There is one app, built three times with different link
	# preview tags (seo/plugin.ts): index.html; aide.html for the help page
	# (/aide, #71); and invite.html for invite links (/?lobby=<code>, "Tu es
	# invité·e à une manif", noindex). All load the same bundles and the
	# client reads the URL itself; the code is never put in the page. Any
	# other path falls back to index.html (SPA). A file (a path with an
	# extension) is never rewritten. `route` keeps these in the order
	# written: /aide first, so /aide?lobby=<code> (the help open over a
	# lobby, then refreshed) is still the help page, not the invite.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		route {
			@help path /aide /aide/
			rewrite @help /aide.html
			@invite {
				query lobby=*
				not path_regexp \.[a-zA-Z0-9]+$
			}
			rewrite @invite /invite.html
			try_files {path} /index.html
		}
		file_server
	}
}
